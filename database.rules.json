{
  "rules": {
    "ranking": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['nome', 'pontos', 'tempo'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },
        "pontos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "tempo": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "acessos": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isNumber() && newData.val() >= 0"
    },
    "ranking_portugues": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['nome', 'pontos', 'tempo'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },
        "pontos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "tempo": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "acessos_portugues": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isNumber() && newData.val() >= 0"
    }
  }
}